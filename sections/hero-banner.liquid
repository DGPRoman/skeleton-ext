{% liquid
  assign image = section.settings.image | default: section.settings.image_mobile
  assign image_mobile = section.settings.image_mobile | default: section.settings.image
  assign alt = section.settings.alt | default: image.alt

  assign wrapper = 'div'
  if section.settings.link != blank
    assign wrapper = 'a'
  endif

  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
%}

{% if image != blank or request.design_mode %}
  <{{ wrapper }}
    class="hero {{ section.settings.height }} full-width"
    style="
      --hero-position: {{ image.presentation.focal_point | default: '50% 50%' }};
      --hero-position-mobile: {{ image_mobile.presentation.focal_point | default: '50% 50%' }};
    "
    {% if wrapper == 'a' %}
      href="{{ section.settings.link }}"
      {% comment %} A linked image is the whole link, so it must carry a name {% endcomment %}
      {% if alt == blank %}
        aria-label="{{ 'hero_banner.link_label' | t | escape }}"
      {% endif %}
    {% endif %}
  >
    {% if image != blank %}
      <picture>
        <source
          media="(max-width: 749px)"
          srcset="{% render 'image-srcset', image: image_mobile, widths: '375, 550, 750, 1100, 1500', max: 1500 %}"
          sizes="100vw"
          width="{{ image_mobile.width }}"
          height="{{ image_mobile.height }}"
        >
        <source
          media="(min-width: 750px)"
          srcset="{% render 'image-srcset', image: image, widths: '750, 1100, 1500, 2000, 2400, 3000', max: 3840 %}"
          sizes="100vw"
          width="{{ image.width }}"
          height="{{ image.height }}"
        >
        <img
          src="{{ image | image_url: width: 1500 }}"
          alt="{{ alt | escape }}"
          width="{{ image.width }}"
          height="{{ image.height }}"
          loading="eager"
          fetchpriority="{{ fetch_priority }}"
        >
      </picture>
    {% else %}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero__placeholder' }}
    {% endif %}
  </{{ wrapper }}>
{% endif %}

{% stylesheet %}
  .hero {
    display: block;
    position: relative;
    aspect-ratio: var(--hero-ratio, auto);
  }

  /* Two tones, so one of them always contrasts with the photo underneath.
     Both are drawn inside, because a full-bleed banner has no outside. */
  .hero:focus-visible {
    outline: 3px solid #fff;
    outline-offset: -3px;
  }

  /* A pseudo-element, not an inset shadow: the image would cover the shadow */
  .hero:focus-visible::after {
    content: '';
    position: absolute;
    inset: 3px;
    border: 3px solid #000;
  }

  .hero picture,
  .hero img,
  .hero__placeholder {
    width: 100%;
    height: 100%;
  }

  /* The crop honours the merchant's focal point, one per art-directed file */
  .hero img {
    object-fit: cover;
    object-position: var(--hero-position-mobile);
  }

  /* Without a ratio the image keeps its own proportions */
  .hero--adapt picture,
  .hero--adapt img,
  .hero--adapt .hero__placeholder {
    height: auto;
  }

  /* Ratios pair with the <source media> queries above */
  .hero--small {
    --hero-ratio: 4 / 3;
  }

  .hero--medium {
    --hero-ratio: 1 / 1;
  }

  .hero--large {
    --hero-ratio: 3 / 4;
  }

  @media (min-width: 750px) {
    .hero img {
      object-position: var(--hero-position);
    }

    .hero--small {
      --hero-ratio: 3 / 1;
    }

    .hero--medium {
      --hero-ratio: 2 / 1;
    }

    .hero--large {
      --hero-ratio: 3 / 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "settings": [
    {"type": "image_picker", "id": "image", "label": "t:labels.background"},
    {"type": "image_picker", "id": "image_mobile", "label": "t:labels.background_mobile"},
    {"type": "text", "id": "alt", "label": "t:labels.image_description"},
    {"type": "url", "id": "link", "label": "t:labels.link"},
    {
      "type": "select",
      "id": "height",
      "label": "t:labels.height",
      "default": "hero--adapt",
      "options": [
        {"value": "hero--adapt", "label": "t:options.height.adapt"},
        {"value": "hero--small", "label": "t:options.height.small"},
        {"value": "hero--medium", "label": "t:options.height.medium"},
        {"value": "hero--large", "label": "t:options.height.large"}
      ]
    }
  ],
  "presets": [{"name": "Hero banner"}]
}
{% endschema %}
