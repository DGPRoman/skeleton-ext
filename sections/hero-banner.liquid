{% liquid
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile | default: image
  assign mobile_widths = '375, 550, 750, 1100, 1500' | split: ', '
  assign desktop_widths = '750, 1100, 1500, 2000, 2400, 3000' | split: ', '
%}

{%- capture srcset_mobile -%}
  {%- for w in mobile_widths -%}
    {%- assign width = w | times: 1 -%}
    {%- if width < image_mobile.width -%}
      {{ image_mobile | image_url: width: width }} {{ width }}w,
    {%- endif -%}
  {%- endfor -%}
  {{ image_mobile | image_url: width: image_mobile.width }} {{ image_mobile.width }}w
{%- endcapture -%}

{%- capture srcset_desktop -%}
  {%- for w in desktop_widths -%}
    {%- assign width = w | times: 1 -%}
    {%- if width < image.width -%}
      {{ image | image_url: width: width }} {{ width }}w,
    {%- endif -%}
  {%- endfor -%}
  {{ image | image_url: width: image.width }} {{ image.width }}w
{%- endcapture -%}

<div class="hero full-width">
    {% if image != blank %}
        <picture>
            <source
                media="(max-width: 749px)"
                srcset="{{ srcset_mobile }}"
                sizes="100vw"
                width="{{ image_mobile.width }}"
                height="{{ image_mobile.height }}"
            >
            <source
                media="(min-width: 750px)"
                srcset="{{ srcset_desktop }}"
                sizes="100vw"
                width="{{ image.width }}"
                height="{{ image.height }}"
            >
            <img
                src="{{ image | image_url: width: 1500 }}"
                alt="{{ image.alt | escape }}"
                width="{{ image.width }}"
                height="{{ image.height }}"
                loading="eager"
                fetchpriority="high"
            >
        </picture>
    {% else %}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero__placeholder' }}
    {% endif %}
    <div class="hero__content">
        {% content_for 'blocks' %}
    </div>
</div>

{% stylesheet %}
  .hero {
    position: relative;
  }

  .hero picture,
  .hero img,
  .hero__placeholder {
    width: 100%;
  }

  .hero__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 1rem;
    padding: var(--page-margin);
    color: #fff;
  }

  .hero__content > * {
    max-width: 40ch;
  }

  @media (min-width: 750px) {
    .hero__content {
      justify-content: center;
      max-width: 50%;
      padding: calc(var(--page-margin) * 2);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "blocks": [{"type": "button"}],
  "settings": [
    {"type": "image_picker", "id": "image", "label": "t:labels.background"},
    {"type": "image_picker", "id": "image_mobile", "label": "t:labels.background_mobile"}
  ],
  "presets": [{"name": "Hero banner"}]
}
{% endschema %}
