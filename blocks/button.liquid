{% doc %}
  Renders a button block.

  @example
  {% content_for 'block', type: 'button', id: 'button' %}
{% enddoc %}
<a
  {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
  {{ block.shopify_attributes }}
>{{ block.settings.label }}</a>
{% schema %}
{
  "name": "Button",
  "settings": [
    {"id": "label", "type": "text", "default": "Button", "label": "t:labels.text"},
    {"id": "link", "type": "url", "label": "t:labels.link" }
  ],
  "presets": [{"name": "Button"}]
}
{% endschema %}
