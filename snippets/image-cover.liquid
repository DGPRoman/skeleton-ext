{% doc %}
  Renders an art-directed image that fills its box and is cropped to it.

  Two files are served, one per viewport, each with its own srcset and its own
  focal point, so a wide banner and a tall phone banner can be different
  photographs rather than two crops of one.

  The box belongs to the caller: give the box one of the banner--* classes from
  critical.css and name the same shape here, so the crop correction below can be
  worked out. The shapes are listed in one place there and translated to numbers
  in one place here; nothing else needs to know them.

  @param {image} image - The image for wide viewports
  @param {image} [image_mobile] - The image below 750px; falls back to `image`
  @param {string} [alt] - Alternative text; falls back to the image's own
  @param {string} [shape] - The banner--* shape of the box; adapt when omitted
  @param {string} [loading] - Loading attribute, 'eager' for anything on screen
  @param {string} [fetch_priority] - Fetch priority, 'high' for the largest paint
  @param {string} [placeholder] - Placeholder SVG drawn when there is no image

  @example
  {% render 'image-cover', image: section.settings.image, shape: 'banner--medium' %}
  {% render 'image-cover',
    image: block.settings.image,
    image_mobile: block.settings.image_mobile,
    alt: block.settings.alt,
    shape: section.settings.shape,
    loading: 'eager',
    fetch_priority: 'high'
  %}
{% enddoc %}

{% liquid
  assign wide = image | default: image_mobile
  assign narrow = image_mobile | default: image
  assign description = alt | default: wide.alt

  # The numbers behind the banner--* shapes. Zero is banner--adapt: the box
  # takes the picture's own proportions, so cover crops nothing and 100vw is
  # already the right answer.
  assign mobile_ratio = 0
  assign desktop_ratio = 0
  case shape
    when 'banner--small'
      assign mobile_ratio = 1.3333
      assign desktop_ratio = 3.0
    when 'banner--medium'
      assign mobile_ratio = 1.0
      assign desktop_ratio = 2.0
    when 'banner--large'
      assign mobile_ratio = 0.75
      assign desktop_ratio = 1.5
  endcase
%}

{%- if wide == blank -%}
  {{ placeholder | default: 'hero-apparel-1' | placeholder_svg_tag: 'image-cover__placeholder' }}
{%- else -%}
  <picture
    class="image-cover"
    style="
      --image-cover-position: {{ wide.presentation.focal_point | default: '50% 50%' }};
      --image-cover-position-mobile: {{ narrow.presentation.focal_point | default: '50% 50%' }};
    "
  >
    <source
      media="(max-width: 749px)"
      srcset="{% render 'image-srcset', image: narrow, widths: '375, 550, 750, 1100, 1500, 2000, 2600', max: 3000 %}"
      sizes="{% render 'image-sizes', image: narrow, ratio: mobile_ratio %}"
      width="{{ narrow.width }}"
      height="{{ narrow.height }}"
    >
    <source
      media="(min-width: 750px)"
      srcset="{% render 'image-srcset', image: wide, widths: '750, 1100, 1500, 2000, 2400, 3000', max: 3840 %}"
      sizes="{% render 'image-sizes', image: wide, ratio: desktop_ratio %}"
      width="{{ wide.width }}"
      height="{{ wide.height }}"
    >
    <img
      src="{{ wide | image_url: width: 1500 }}"
      alt="{{ description | escape }}"
      width="{{ wide.width }}"
      height="{{ wide.height }}"
      loading="{{ loading | default: 'lazy' }}"
      fetchpriority="{{ fetch_priority | default: 'auto' }}"
    >
  </picture>
{%- endif -%}

{% stylesheet %}
  .image-cover,
  .image-cover img,
  .image-cover__placeholder {
    width: 100%;
    height: 100%;
  }

  /* The crop honours the merchant's focal point, one per art-directed file */
  .image-cover img {
    object-fit: cover;
    object-position: var(--image-cover-position-mobile);
  }

  @media (min-width: 750px) {
    .image-cover img {
      object-position: var(--image-cover-position);
    }
  }
{% endstylesheet %}
