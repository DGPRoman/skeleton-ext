{% liquid
  assign image = section.settings.image | default: section.settings.image_mobile
  assign image_mobile = section.settings.image_mobile | default: section.settings.image
  assign alt = section.settings.alt | default: image.alt

  assign wrapper = 'div'
  if section.settings.link != blank
    assign wrapper = 'a'
  endif

  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
%}

{% if image != blank or request.design_mode %}
  <{{ wrapper }}
    class="hero full-width"
    {% if wrapper == 'a' %}
      href="{{ section.settings.link }}"
    {% endif %}
  >
    {% if image != blank %}
      <picture>
        <source
          media="(max-width: 749px)"
          srcset="{% render 'image-srcset', image: image_mobile, widths: '375, 550, 750, 1100, 1500', max: 1500 %}"
          sizes="100vw"
          width="{{ image_mobile.width }}"
          height="{{ image_mobile.height }}"
        >
        <source
          media="(min-width: 750px)"
          srcset="{% render 'image-srcset', image: image, widths: '750, 1100, 1500, 2000, 2400, 3000', max: 3840 %}"
          sizes="100vw"
          width="{{ image.width }}"
          height="{{ image.height }}"
        >
        <img
          src="{{ image | image_url: width: 1500 }}"
          alt="{{ alt | escape }}"
          width="{{ image.width }}"
          height="{{ image.height }}"
          loading="eager"
          fetchpriority="{{ fetch_priority }}"
        >
      </picture>
    {% else %}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero__placeholder' }}
    {% endif %}
  </{{ wrapper }}>
{% endif %}

{% stylesheet %}
  .hero {
    display: block;
    position: relative;
  }

  .hero:focus-visible {
    /* Negative offset keeps the ring inside a full-bleed banner */
    outline: 2px solid currentcolor;
    outline-offset: -4px;
  }

  .hero picture,
  .hero img,
  .hero__placeholder {
    width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "settings": [
    {"type": "image_picker", "id": "image", "label": "t:labels.background"},
    {"type": "image_picker", "id": "image_mobile", "label": "t:labels.background_mobile"},
    {"type": "text", "id": "alt", "label": "t:labels.image_description"},
    {"type": "url", "id": "link", "label": "t:labels.link"}
  ],
  "presets": [{"name": "Hero banner"}]
}
{% endschema %}
