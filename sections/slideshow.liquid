{% liquid
  assign count = section.blocks.size

  # A single slide is a banner, not a slideshow: nothing to rotate
  assign autoplay = false
  if count > 1 and section.settings.autoplay
    assign autoplay = true
  endif
%}

{% if count > 0 %}
  {% comment %}
    The region sits out here so it covers the pause control as well as the
    slides. Swiper puts its own roledescription on a div inside its shadow DOM,
    where it never reaches the element carrying the name.
  {% endcomment %}
  <theme-slideshow
    class="slideshow {{ section.settings.shape }} full-width"
    role="region"
    aria-roledescription="{{ 'carousel.role' | t | escape }}"
    aria-label="{{ 'slideshow.label' | t | escape }}"
  >
    {% comment %}
      Swiper reads its parameters off these attributes when initialize() is
      called. Rewind rather than loop: a crossfade has no direction, so there is
      nothing to gain from Swiper reordering the slides in the DOM.

      The translated announcements come from the shared carousel-a11y snippet.
    {% endcomment %}
    <swiper-container
      class="slideshow__swiper"
      init="false"
      slides-per-view="1"
      effect="fade"
      fade-effect-cross-fade="true"
      speed="1000"
      rewind="true"
      keyboard-enabled="true"
      {% render 'carousel-a11y' %}
      {% if autoplay %}
        autoplay-delay="{{ section.settings.interval | times: 1000 }}"
        autoplay-disable-on-interaction="false"
      {% endif %}
    >
      {% for block in section.blocks %}
        {% liquid
          assign image = block.settings.image | default: block.settings.image_mobile
          assign alt = block.settings.alt | default: image.alt

          # The first slide is the one on screen, and on the home page it is the
          # largest paint. The rest are behind a crossfade nobody has asked for yet.
          assign loading = 'lazy'
          assign fetch_priority = 'auto'
          if forloop.first
            assign loading = 'eager'
            if section.index == 1
              assign fetch_priority = 'high'
            endif
          endif
        %}

        <swiper-slide
          class="slideshow__slide"
          data-index="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.link != blank -%}
            <a
              class="slideshow__link banner-link"
              href="{{ block.settings.link }}"
              {% comment %} A linked image is the whole link, so it must carry a name {% endcomment %}
              {% if alt == blank %}
                aria-label="{{ 'slideshow.link_label' | t | escape }}"
              {% endif %}
            >
          {%- endif -%}

          {%- comment -%} Placeholders differ per slide, so an empty slideshow still reads as one {%- endcomment -%}
          {%- capture placeholder -%}{%- cycle 'hero-apparel-1', 'hero-apparel-2', 'hero-apparel-3' -%}{%- endcapture -%}

          {% render 'image-cover',
            image: block.settings.image,
            image_mobile: block.settings.image_mobile,
            alt: block.settings.alt,
            shape: section.settings.shape,
            loading: loading,
            fetch_priority: fetch_priority,
            placeholder: placeholder
          %}

          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        </swiper-slide>
      {% endfor %}
    </swiper-container>

    {% if autoplay %}
      {% comment %}
        Moving content that starts on its own has to be stoppable, and Swiper has
        no control of its own. This one is out of sight until it is tabbed to, so
        the banner carries no chrome at all; a pointer stops it by resting on it
        instead.
      {% endcomment %}
      <button
        class="slideshow__pause"
        type="button"
        aria-label="{{ 'slideshow.pause' | t | escape }}"
        data-label-pause="{{ 'slideshow.pause' | t | escape }}"
        data-label-play="{{ 'slideshow.play' | t | escape }}"
      >
        <span class="slideshow__pause-icon">{{ 'icon-pause.svg' | inline_asset_content }}</span>
        <span class="slideshow__play-icon">{{ 'icon-play.svg' | inline_asset_content }}</span>
      </button>
    {% endif %}
  </theme-slideshow>
{% endif %}

{% stylesheet %}
  /* Relative for the one absolutely positioned thing left inside it */
  .slideshow {
    display: block;
    position: relative;
  }

  /* The box is the carousel rather than the host, so the crossfade happens
     inside a shape that never changes. The width is spelled out: a ratio alone
     gives the element no intrinsic width, and it would collapse to nothing in a
     content-sized column. */
  .slideshow__swiper {
    display: block;
    width: 100%;
    aspect-ratio: var(--banner-ratio);
  }

  /* Before the engine upgrades the element, its children are plain unknown tags:
     without this they stack down the page at their natural height. Scoped to
     this carousel's own class, because every section's stylesheet ends up in
     one bundle and a bare swiper-container rule would reach all of them. */
  .slideshow__swiper:not(:defined) {
    overflow: hidden;
  }

  .slideshow__swiper:not(:defined) > swiper-slide {
    display: none;
  }

  .slideshow__swiper:not(:defined) > swiper-slide:first-child {
    display: block;
    height: 100%;
  }

  .slideshow__slide {
    position: relative;
    height: 100%;
  }

  /* banner-link brings the block, the position and the focus ring with it */
  .slideshow__link {
    width: 100%;
    height: 100%;
  }

  .slideshow__pause {
    display: grid;
    place-items: center;
    position: absolute;
    inset-block-end: clamp(0.75rem, 2vw, 1.5rem);
    inset-inline-end: clamp(0.75rem, 2vw, 1.5rem);
    z-index: 1;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background-color: rgb(255 255 255 / 0.8);
    color: #000;
    cursor: pointer;
  }

  .slideshow__pause:hover {
    background-color: rgb(255 255 255 / 1);
  }

  /* Out of sight, but still in the tab order, and still in the corner it will
     appear in. Not display:none and not visibility:hidden: either of those
     would take it out of the tab order along with the picture. :focus rather
     than :focus-visible, or a click on it would make it disappear. */
  .slideshow__pause:not(:focus) {
    width: 1px;
    height: 1px;
    /* clip-path hides the icon but leaves it in the scrollable overflow, which
       is 7px of sideways scroll on a phone. This is what takes it out. */
    overflow: hidden;
    clip-path: inset(50%);
  }

  .slideshow__pause svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .slideshow__pause-icon,
  .slideshow__play-icon {
    display: block;
  }

  /* The button says what it does next, so one icon is always the hidden one.
     Both states are one class deep, so the later rule is the one that wins. */
  .slideshow__play-icon,
  .slideshow--paused .slideshow__pause-icon {
    display: none;
  }

  .slideshow--paused .slideshow__play-icon {
    display: block;
  }

  .slideshow__pause:focus-visible {
    outline: 2px solid #000;
    outline-offset: 2px;
    box-shadow: 0 0 0 4px #fff;
  }

  /* Author colours are discarded here, system colours are not, so name one */
  @media (forced-colors: active) {
    .slideshow__pause:focus-visible {
      outline-color: Highlight;
    }
  }
{% endstylesheet %}

{% javascript %}
  class ThemeSlideshow extends HTMLElement {
    // Every reason to sit still is named, so one lifting does not undo another
    #holds = new Set(['offscreen']);
    #controller = null;
    #observer = null;

    connectedCallback() {
      if (this.#controller) return;

      this.container = this.querySelector('swiper-container');
      if (!this.container) return;

      // Both bundles are deferred, so the engine may land after this one does
      customElements.whenDefined('swiper-container').then(() => this.#start());
    }

    disconnectedCallback() {
      this.#controller?.abort();
      this.#controller = null;
      this.#observer?.disconnect();
      this.#observer = null;
    }

    #start() {
      if (!this.isConnected) return;

      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const pause = this.querySelector('.slideshow__pause');

      // Property setters only fill passedParams until initialize() runs, which
      // is what init="false" buys. Autoplay has to be off before that, or a
      // later start() would set a reduced-motion visitor's banner moving.
      if (reduced) {
        this.container.autoplay = false;
        // Nothing will ever move now, so the control would be a dead one
        pause?.remove();
      }

      this.container.initialize();
      this.swiper = this.container.swiper;

      // Attributes win over properties in getParams(), and the crossfade
      // duration is one of them, so it can only be cut once Swiper has read it.
      if (reduced) this.swiper.params.speed = 0;

      this.#controller = new AbortController();
      const signal = this.#controller.signal;

      if (this.swiper.params.autoplay?.enabled) this.#watchAutoplay(pause, signal);
      this.#watchEditor(signal);
    }

    // Everything that can stop the banner, and the one control that can start
    // it again. Only wired when there is something to stop.
    #watchAutoplay(pause, signal) {
      pause?.addEventListener('click', () => this.#toggle(pause), { signal });

      // Swiper has a pauseOnMouseEnter of its own, but it drives its own
      // pause/resume pair, which would restart a banner the visitor stopped.
      this.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'mouse') this.#hold('hover');
      }, { signal });

      this.addEventListener('pointerleave', (event) => {
        if (event.pointerType === 'mouse') this.#release('hover');
      }, { signal });

      // Swiper stops autoplay for a hidden tab on its own, but not for a
      // slideshow that has been scrolled past.
      this.#observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) this.#release('offscreen');
          else this.#hold('offscreen');
        },
        { threshold: 0.25 }
      );

      this.#observer.observe(this);
    }

    // In the theme editor the merchant drives, so autoplay waits its turn.
    // These events are announced on the document for every section on the page,
    // so each one has to ask whether it was the one meant — once, here.
    #watchEditor(signal) {
      const mine = (event) => this.contains(event.target) || event.target.contains(this);
      const on = (name, handler) =>
        document.addEventListener(name, (event) => {
          if (mine(event)) handler(event);
        }, { signal });

      on('shopify:section:select', () => this.#hold('editor'));
      on('shopify:section:deselect', () => this.#release('editor'));
      on('shopify:block:deselect', () => this.#release('editor'));

      on('shopify:block:select', (event) => {
        this.#hold('editor');

        // Rewind leaves the slides where they were authored, so the index holds
        const index = Number(event.target.dataset.index);
        if (Number.isInteger(index)) this.swiper.slideTo(index);
      });
    }

    #hold(reason) {
      this.#holds.add(reason);
      this.swiper?.autoplay?.stop();
    }

    #release(reason) {
      this.#holds.delete(reason);
      if (this.#holds.size === 0) this.swiper?.autoplay?.start();
    }

    #toggle(button) {
      const paused = this.#holds.has('visitor');

      if (paused) this.#release('visitor');
      else this.#hold('visitor');

      this.classList.toggle('slideshow--paused', !paused);
      button.setAttribute('aria-label', paused ? button.dataset.labelPause : button.dataset.labelPlay);
    }
  }

  if (!customElements.get('theme-slideshow')) {
    customElements.define('theme-slideshow', ThemeSlideshow);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.slideshow",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "shape",
      "label": "t:labels.height",
      "default": "banner--medium",
      "options": [
        {"value": "banner--small", "label": "t:options.height.small"},
        {"value": "banner--medium", "label": "t:options.height.medium"},
        {"value": "banner--large", "label": "t:options.height.large"}
      ]
    },
    {"type": "checkbox", "id": "autoplay", "label": "t:labels.autoplay", "default": true},
    {
      "type": "range",
      "id": "interval",
      "label": "t:labels.autoplay_interval",
      "visible_if": "{{ section.settings.autoplay }}",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:general.slide",
      "settings": [
        {"type": "image_picker", "id": "image", "label": "t:labels.background"},
        {"type": "image_picker", "id": "image_mobile", "label": "t:labels.background_mobile"},
        {"type": "text", "id": "alt", "label": "t:labels.image_description"},
        {"type": "url", "id": "link", "label": "t:labels.link"}
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.slideshow",
      "blocks": [{"type": "slide"}, {"type": "slide"}, {"type": "slide"}]
    }
  ]
}
{% endschema %}
