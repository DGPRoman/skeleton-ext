{% doc %}
  Renders a sizes value for an image cropped with object-fit: cover.

  When the file is wider than the box, cover paints it wider than the box, so
  the browser has to be told to pick a larger candidate than the box's width.

  @param {image} image - The image that will be cropped
  @param {number} ratio - Width over height of the box, or 0 when the box takes the image's own ratio
  @param {number} [box] - The box's width as a percentage of the viewport; the whole of it when omitted

  @example
  <source sizes="{% render 'image-sizes', image: section.settings.image, ratio: 2.0 %}">
  <source sizes="{% render 'image-sizes', image: block.settings.image, ratio: 1.0, box: 50 %}">
{% enddoc %}
{%- liquid
  assign width = box | default: 100
  if ratio > 0
    assign image_ratio = image.width | times: 1.0 | divided_by: image.height
    if image_ratio > ratio
      assign width = image_ratio | divided_by: ratio | times: width | round
    endif
  endif
  echo width | append: 'vw'
-%}
